rules_version = '2';

// Banger Picks Firestore rules.
//
// Cloud Functions (updateLiveFixtures, autoScoring, onGameweekUpdate,
// trackReferralSignup) use the Admin SDK and bypass these rules. They still
// own awarding points, week-placement bonuses, referral rewards, and refreshing
// fixture status.
//
// Shop balance is correctPredictions + referralPoints - pointsSpent.
// pointsSpent must already exist on the user (migration sets it, including 0).
// A missing field denies new redemptions so old spend cannot be reused.
// Ranking `points` are not spendable.
// Cancelling a redemption does not refund pointsSpent (admin adjusts it).
//
// Signed-in reads of users/{uid} return the whole document. Rankings, referral
// lookup, and display-name checks need that, and rules cannot hide fields.
// isAdmin, pointsSpent, referralPoints, referredBy, and lastShopRedemptionId
// are therefore visible to any signed-in user. adminUids stay admin-only.
// Anonymous clients cannot read user documents.

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userIsAdminFlag() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    function uidInAdminList() {
      return exists(/databases/$(database)/documents/settings/app)
        && get(/databases/$(database)/documents/settings/app).data.keys().hasAny(['adminUids'])
        && get(/databases/$(database)/documents/settings/app).data.adminUids is list
        && get(/databases/$(database)/documents/settings/app).data.adminUids.hasAny([request.auth.uid]);
    }

    function isAdmin() {
      return isSignedIn() && (userIsAdminFlag() || uidInAdminList());
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function settingsExist() {
      return exists(/databases/$(database)/documents/settings/app);
    }

    function settingsData() {
      return get(/databases/$(database)/documents/settings/app).data;
    }

    function registrationsOpen() {
      return !settingsExist()
        || settingsData().get('allowRegistrations', true) != false;
    }

    function shopIsEnabled() {
      return !settingsExist()
        || settingsData().get('shopEnabled', true) != false;
    }

    function maintenanceOn() {
      return settingsExist() && settingsData().get('maintenance', false) == true;
    }

    function isPublicGameweekStatus(status) {
      return status in ['active', 'completed', 'archived'];
    }

    function gameweekReadable(gameweekId) {
      return isAdmin()
        || (
          exists(/databases/$(database)/documents/gameweeks/$(gameweekId))
          && isPublicGameweekStatus(get(/databases/$(database)/documents/gameweeks/$(gameweekId)).data.get('status', ''))
        );
    }

    function displayNameOk(value) {
      return value is string && value.size() >= 2 && value.size() <= 30;
    }

    function validUserCreate(userId) {
      return registrationsOpen()
        && isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'photoURL',
          'points',
          'referralCode',
          'referralPoints',
          'referredBy',
          'hasSeenOnboardingIntro',
          'pointsSpent',
          'createdAt',
          'lastUpdated'
        ])
        && request.resource.data.uid == userId
        && displayNameOk(request.resource.data.displayName)
        && (
          request.resource.data.photoURL == null
          || (request.resource.data.photoURL is string
            && request.resource.data.photoURL.size() > 0
            && request.resource.data.photoURL.size() <= 2048)
        )
        && request.resource.data.points == 0
        && request.resource.data.pointsSpent == 0
        && request.resource.data.referralCode is string
        && request.resource.data.referralCode.matches('^[A-Z0-9]{4,16}$')
        && request.resource.data.referralPoints == 0
        && (
          request.resource.data.referredBy == null
          || (request.resource.data.referredBy is string && request.resource.data.referredBy.size() <= 128)
        )
        && request.resource.data.hasSeenOnboardingIntro == false
        && request.resource.data.createdAt is timestamp
        && request.resource.data.lastUpdated is timestamp;
    }

    function favoritePlayerShapeOk() {
      let player = request.resource.data.favoritePlayer;
      return player is map
        && player.keys().hasOnly(['id', 'name', 'photo'])
        && player.id is int
        && player.name is string
        && player.name.size() > 0
        && player.name.size() <= 80
        && player.photo is string
        && player.photo.size() > 0
        && player.photo.size() <= 2048;
    }

    function favoritePlayerOptionMatches(player, redemption) {
      let item = get(/databases/$(database)/documents/shopItems/$(redemption.itemId)).data;
      let playerKey = redemption.redemptionData.playerKey;
      return item.keys().hasAny(['customization'])
        && item.customization is map
        && item.customization.get('type', '') == 'favoritePlayer'
        && item.customization.optionsById is map
        && playerKey is string
        && item.customization.optionsById.keys().hasAny([playerKey])
        && item.customization.optionsById[playerKey].playerId == player.id
        && item.customization.optionsById[playerKey].name == player.name
        && item.customization.optionsById[playerKey].photo == player.photo
        && item.customization.optionsById[playerKey].pointsCost == redemption.pointsCost
        && redemption.redemptionData.playerId == player.id
        && redemption.redemptionData.playerName == player.name
        && redemption.redemptionData.playerPhoto == player.photo;
    }

    // Setting a favorite player requires that player's redemption, already
    // fulfilled or fulfilled in this batch (getAfter). Clearing it does not.
    function favoritePlayerBackedByRedemption() {
      let player = request.resource.data.favoritePlayer;
      let redemptionId = request.resource.data.favoritePlayerRedemptionId;
      let redemption = getAfter(/databases/$(database)/documents/redemptions/$(redemptionId)).data;
      return redemptionId is string
        && redemption.userId == request.auth.uid
        && redemption.status == 'fulfilled'
        && redemption.keys().hasAny(['redemptionData'])
        && redemption.redemptionData is map
        && favoritePlayerOptionMatches(player, redemption);
    }

    function validOwnerProfileUpdate(userId) {
      return resource != null
        && isOwner(userId)
        && changedKeys().hasOnly([
          'displayName',
          'photoURL',
          'referralCode',
          'language',
          'favoritePlayer',
          'favoritePlayerRedemptionId',
          'hasSeenOnboardingIntro',
          'lastUpdated'
        ])
        && (!changedKeys().hasAny(['displayName']) || displayNameOk(request.resource.data.displayName))
        && (
          !changedKeys().hasAny(['photoURL'])
          || request.resource.data.photoURL == null
          || (request.resource.data.photoURL is string
            && request.resource.data.photoURL.size() > 0
            && request.resource.data.photoURL.size() <= 2048)
        )
        && (!changedKeys().hasAny(['language']) || request.resource.data.language in ['en', 'es-MX'])
        && (!changedKeys().hasAny(['hasSeenOnboardingIntro']) || request.resource.data.hasSeenOnboardingIntro is bool)
        && (!changedKeys().hasAny(['lastUpdated']) || request.resource.data.lastUpdated is timestamp)
        && (
          !changedKeys().hasAny(['referralCode'])
          || (
            (!resource.data.keys().hasAny(['referralCode']) || resource.data.referralCode == null)
            && request.resource.data.referralCode is string
            && request.resource.data.referralCode.matches('^[A-Z0-9]{4,16}$')
          )
        )
        && (
          !changedKeys().hasAny(['favoritePlayerRedemptionId'])
          || (
            changedKeys().hasAny(['favoritePlayer'])
            && request.resource.data.favoritePlayer is map
            && request.resource.data.favoritePlayerRedemptionId is string
            && request.resource.data.favoritePlayerRedemptionId.size() <= 160
          )
        )
        && (
          !changedKeys().hasAny(['favoritePlayer'])
          || request.resource.data.favoritePlayer == null
          || (favoritePlayerShapeOk() && favoritePlayerBackedByRedemption())
        );
    }

    // The only owner write that may touch pointsSpent: +cost, same batch as
    // the new redemption named by lastShopRedemptionId.
    function validPointsSpentCharge(userId) {
      let spentBefore = resource.data.pointsSpent;
      let spentAfter = request.resource.data.pointsSpent;
      let redemptionId = request.resource.data.lastShopRedemptionId;
      let path = /databases/$(database)/documents/redemptions/$(redemptionId);
      return resource != null
        && isOwner(userId)
        && !maintenanceOn()
        && resource.data.keys().hasAny(['pointsSpent'])
        && changedKeys().hasOnly(['pointsSpent', 'lastShopRedemptionId'])
        && spentBefore is int
        && spentAfter is int
        && redemptionId is string
        && redemptionId.size() <= 160
        && !exists(path)
        && existsAfter(path)
        && getAfter(path).data.userId == userId
        && getAfter(path).data.status == 'pending'
        && getAfter(path).data.pointsCost is int
        && spentAfter == spentBefore + getAfter(path).data.pointsCost;
    }

    function teamOk(team) {
      return team is map
        && team.keys().hasOnly(['id', 'name', 'logo'])
        && team.id is int
        && team.name is string
        && team.name.size() > 0
        && team.name.size() <= 80
        && team.logo is string
        && team.logo.size() <= 2000;
    }

    function leagueOk(league) {
      return league is map
        && league.keys().hasOnly(['id', 'name', 'country', 'logo'])
        && league.id is int
        && league.name is string
        && league.name.size() <= 80
        && league.country is string
        && league.country.size() <= 60
        && league.logo is string
        && league.logo.size() <= 2000;
    }

    function resultOk() {
      return request.resource.data.result == null
        || (
          request.resource.data.result is map
          && request.resource.data.result.keys().hasOnly(['homeGoals', 'awayGoals'])
          && request.resource.data.result.homeGoals is int
          && request.resource.data.result.awayGoals is int
        );
    }

    function fixturePath(gameweekId, fixtureId) {
      return /databases/$(database)/documents/gameweeks/$(gameweekId)/fixtures/$(fixtureId);
    }

    function gameweekPath(gameweekId) {
      return /databases/$(database)/documents/gameweeks/$(gameweekId);
    }

    function effectiveGameweekLock(gameweek) {
      return gameweek.keys().hasAny(['lockAt']) && gameweek.lockAt is timestamp
        ? gameweek.lockAt
        : gameweek.deadline;
    }

    function gameweekStillOpen(gameweekId) {
      let gameweek = get(gameweekPath(gameweekId)).data;
      let lock = effectiveGameweekLock(gameweek);
      return gameweek.status == 'active'
        && (
          gameweek.get('forceOpenForTesting', false) == true
          || (lock is timestamp && request.time < lock)
        );
    }

    function fixtureNotStarted(gameweekId, fixtureId) {
      let fixture = get(fixturePath(gameweekId, fixtureId)).data;
      return fixture.fixture.fixture.status.short in ['NS', 'TBD'];
    }

    // forceOpenForTesting skips the deadline only. Finished fixtures stay locked.
    // One get() per doc — calling gameweekStillOpen/fixtureNotStarted again would double reads.
    function picksOpen(gameweekId, fixtureId) {
      let gameweek = get(gameweekPath(gameweekId)).data;
      let fixture = get(fixturePath(gameweekId, fixtureId)).data;
      let lock = effectiveGameweekLock(gameweek);
      return gameweek.status == 'active'
        && (
          gameweek.get('forceOpenForTesting', false) == true
          || (lock is timestamp && request.time < lock)
        )
        && fixture.fixture.fixture.status.short in ['NS', 'TBD'];
    }

    function scoringFieldsFresh() {
      return request.resource.data.awarded == false
        && request.resource.data.points == 0
        && request.resource.data.correct == null
        && (
          resource == null
          || (
            resource.data.get('awarded', false) == false
            && resource.data.get('points', 0) == 0
            && resource.data.get('correct', null) == null
          )
        );
    }

    // Legacy entries stored a `ts` timestamp. Merge writes keep it.
    function legacyTsOk() {
      return !request.resource.data.keys().hasAny(['ts'])
        || (
          resource != null
          && request.resource.data.ts is timestamp
          && !changedKeys().hasAny(['ts'])
        );
    }

    function validPredictionWrite(entryUid, fixtureId) {
      return isOwner(entryUid)
        && fixtureId.matches('^[0-9]+$')
        && request.resource.data.keys().hasOnly([
          'uid',
          'fixtureId',
          'gameweekId',
          'pick',
          'createdAt',
          'awarded',
          'points',
          'correct',
          'homeTeam',
          'awayTeam',
          'league',
          'fixtureDate',
          'status',
          'result',
          'ts'
        ])
        && legacyTsOk()
        && request.resource.data.uid == entryUid
        && request.resource.data.fixtureId == int(fixtureId)
        && request.resource.data.gameweekId is string
        && request.resource.data.gameweekId.matches('^[A-Za-z0-9_-]{1,80}$')
        && request.resource.data.pick in ['H', 'D', 'A']
        && request.resource.data.createdAt == request.time
        && request.resource.data.awarded is bool
        && request.resource.data.points is int
        && request.resource.data.status is string
        && request.resource.data.status.size() <= 12
        && request.resource.data.fixtureDate is timestamp
        && teamOk(request.resource.data.homeTeam)
        && teamOk(request.resource.data.awayTeam)
        && leagueOk(request.resource.data.league)
        && resultOk()
        && scoringFieldsFresh()
        && picksOpen(request.resource.data.gameweekId, fixtureId);
    }

    function redemptionPath(redemptionId) {
      return /databases/$(database)/documents/redemptions/$(redemptionId);
    }

    function redemptionIdMatches(redemptionId, itemId) {
      return redemptionId is string
        && redemptionId.size() <= 160
        && redemptionId.matches('^' + request.auth.uid + '_' + itemId + '_[A-Za-z0-9]+$');
    }

    function newRedemptionForItem(itemId, redemptionId) {
      let path = redemptionPath(redemptionId);
      return redemptionIdMatches(redemptionId, itemId)
        && !exists(path)
        && existsAfter(path)
        && getAfter(path).data.itemId == itemId
        && getAfter(path).data.userId == request.auth.uid
        && getAfter(path).data.status == 'pending';
    }

    function isStockDecrement(itemId) {
      let redemptionId = request.resource.data.lastRedemptionId;
      return resource != null
        && isSignedIn()
        && !maintenanceOn()
        && resource.data.get('stock', null) is int
        && resource.data.stock > 0
        && request.resource.data.stock == resource.data.stock - 1
        && changedKeys().hasOnly(['stock', 'updatedAt', 'lastRedemptionId'])
        && request.resource.data.updatedAt == request.time
        && newRedemptionForItem(itemId, redemptionId);
    }

    function stockTracked(item) {
      return item.get('stock', null) is int;
    }

    // Stock-tracked items must drop by 1 in this batch, tied to this redemption.
    function stockPaired(itemId, redemptionId, item) {
      let after = getAfter(/databases/$(database)/documents/shopItems/$(itemId)).data;
      return !stockTracked(item)
        || (
          item.stock > 0
          && after.stock == item.stock - 1
          && after.lastRedemptionId == redemptionId
        );
    }

    // correctPredictions + referralPoints - pointsSpent.
    // pointsSpent must already exist. correctPredictions and referralPoints
    // may be missing and count as 0, so a referral-only balance still works.
    function shopBalanceOk(cost, redemptionId) {
      let before = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let after = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let spentBefore = before.pointsSpent;
      let spentAfter = after.pointsSpent;
      let earned = after.get('correctPredictions', 0) + after.get('referralPoints', 0);
      let minimum = settingsExist() ? settingsData().get('minRedemptionPoints', 0) : 0;
      return before.keys().hasAny(['pointsSpent'])
        && spentBefore is int
        && spentAfter is int
        && cost is int
        && cost > 0
        && spentAfter == spentBefore + cost
        && after.get('lastShopRedemptionId', '') == redemptionId
        && earned is number
        && earned >= minimum
        && earned - spentAfter >= 0;
    }

    function favoriteOptionMatches(item, cost) {
      let data = request.resource.data.redemptionData;
      return data is map
        && data.keys().hasOnly(['playerId', 'playerName', 'playerPhoto', 'pointsCost', 'playerKey'])
        && data.playerKey is string
        && data.playerKey.matches('^[0-9]{1,12}$')
        && data.playerId is int
        && data.playerName is string
        && data.playerName.size() > 0
        && data.playerName.size() <= 80
        && data.playerPhoto is string
        && data.playerPhoto.size() > 0
        && data.playerPhoto.size() <= 2048
        && data.pointsCost == cost
        && item.customization.optionsById is map
        && item.customization.optionsById.keys().hasAny([data.playerKey])
        && item.customization.optionsById[data.playerKey].playerId == data.playerId
        && item.customization.optionsById[data.playerKey].name == data.playerName
        && item.customization.optionsById[data.playerKey].photo == data.playerPhoto
        && item.customization.optionsById[data.playerKey].pointsCost == cost;
    }

    function isFavoritePlayerItem(item) {
      return item.keys().hasAny(['customization'])
        && item.customization is map
        && item.customization.get('type', '') == 'favoritePlayer'
        && item.customization.keys().hasAny(['optionsById'])
        && item.customization.optionsById is map;
    }

    function validRedemptionCreate(redemptionId) {
      let item = get(/databases/$(database)/documents/shopItems/$(request.resource.data.itemId)).data;
      let cost = request.resource.data.pointsCost;
      return shopIsEnabled()
        && !maintenanceOn()
        && isSignedIn()
        && redemptionIdMatches(redemptionId, request.resource.data.itemId)
        && request.resource.data.redemptionId == redemptionId
        && request.resource.data.keys().hasOnly([
          'redemptionId',
          'userId',
          'itemId',
          'itemName',
          'pointsCost',
          'redeemedAt',
          'status',
          'updatedAt',
          'redemptionData'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.itemId is string
        && request.resource.data.itemId.matches('^[A-Za-z0-9_-]{1,80}$')
        && request.resource.data.itemName is string
        && request.resource.data.itemName.size() <= 100
        && request.resource.data.itemName == item.name
        && item.status == 'active'
        && request.resource.data.redeemedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && shopBalanceOk(cost, redemptionId)
        && stockPaired(request.resource.data.itemId, redemptionId, item)
        && (
          isFavoritePlayerItem(item)
            ? favoriteOptionMatches(item, cost)
            : cost == item.pointsCost && !request.resource.data.keys().hasAny(['redemptionData'])
        );
    }

    // Owner fulfillment is pending -> fulfilled only. cancelled stays terminal.
    function ownerFulfillsRedemption() {
      return resource != null
        && isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'fulfilled'
        && changedKeys().hasOnly(['status', 'updatedAt', 'fulfilledAt'])
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.fulfilledAt is timestamp;
    }

    match /users/{userId} {
      // Whole documents are readable by any signed-in user (rankings, referral
      // codes, display names). isAdmin therefore rides along; rules cannot hide
      // one field. Anonymous reads are denied.
      allow read: if isSignedIn();
      allow create: if validUserCreate(userId);
      allow update: if isAdmin() || validOwnerProfileUpdate(userId) || validPointsSpentCharge(userId);
      allow delete: if false;

      match /gameweek_predictions/{gameweekId} {
        allow read: if isOwner(userId);
        allow create: if cacheCreateOk(userId);
        allow update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['predictions', 'updatedAt'])
          && request.resource.data.predictions is map
          && request.resource.data.predictions.size() <= 10
          && request.resource.data.updatedAt is timestamp;
        allow delete: if false;
      }
    }

    function cacheCreateOk(userId) {
      let joined = request.resource.data.joinedFixtureId;
      return isOwner(userId)
        && request.resource.data.predictions is map
        && request.resource.data.predictions.size() > 0
        && request.resource.data.predictions.size() <= 10
        && request.resource.data.updatedAt is timestamp
        && (
          request.resource.data.keys().hasOnly(['predictions', 'updatedAt'])
          || (
            request.resource.data.keys().hasOnly(['predictions', 'updatedAt', 'joinedFixtureId'])
            && joined is string
            && joined.matches('^[0-9]+$')
            && !exists(/databases/$(database)/documents/predictions/$(joined)/entries/$(userId))
            && existsAfter(/databases/$(database)/documents/predictions/$(joined)/entries/$(userId))
          )
        );
    }

    function predictionEntryPath(fixtureId) {
      return /databases/$(database)/documents/predictions/$(fixtureId)/entries/$(request.auth.uid);
    }

  // FieldValue.increment() is not visible in request.resource.data on create; allow
  // exists-only parent creates proven by the same-batch entry write.
    // FieldValue.increment() may omit playerCount from request.resource; getAfter holds the result.
    function parentCreateWithCount(fixtureId) {
      return isSignedIn()
        && fixtureId.matches('^[0-9]+$')
        && request.resource.data.exists == true
        && existsAfter(predictionEntryPath(fixtureId))
        && (
          (
            request.resource.data.keys().hasOnly(['exists', 'playerCount'])
            && request.resource.data.playerCount == 1
          )
          || request.resource.data.keys().hasOnly(['exists'])
        );
    }

    function parentCountBefore() {
      return resource.data.keys().hasAny(['playerCount']) && resource.data.playerCount is int
        ? resource.data.playerCount
        : 0;
    }

    function parentCountBump(fixtureId) {
      let afterCount = getAfter(/databases/$(database)/documents/predictions/$(fixtureId)).data.get('playerCount', 0);
      return resource != null
        && isSignedIn()
        && fixtureId.matches('^[0-9]+$')
        && request.resource.data.exists == true
        && changedKeys().hasOnly(['playerCount'])
        && afterCount == parentCountBefore() + 1
        && afterCount is int
        && !exists(predictionEntryPath(fixtureId))
        && existsAfter(predictionEntryPath(fixtureId));
    }

    function parentTouch(fixtureId) {
      return resource != null
        && isSignedIn()
        && fixtureId.matches('^[0-9]+$')
        && request.resource.data.exists == true
        && !changedKeys().hasAny(['playerCount'])
        && (
          request.resource.data.keys().hasOnly(['exists'])
          || (
            request.resource.data.keys().hasOnly(['exists', 'playerCount'])
            && changedKeys().hasOnly(['exists'])
          )
        );
    }

    // Security rules count up to 10 exists/get/getAfter per operation and 20 per
    // batch (https://firebase.google.com/docs/firestore/quotas). isAdmin() must not
    // be evaluated first on the player save path — || short-circuits on the left.
    match /predictions/{fixtureId} {
      allow read: if true;
      allow create: if (parentCreateWithCount(fixtureId) && !maintenanceOn()) || isAdmin();
      allow update: if ((parentCountBump(fixtureId) || parentTouch(fixtureId)) && !maintenanceOn()) || isAdmin();
      allow delete: if false;

      match /entries/{entryUid} {
        // Rankings list entries while signed in. Signed-out player count fails closed.
        allow read: if isSignedIn();
        allow create: if (validPredictionWrite(entryUid, fixtureId) && !maintenanceOn()) || isAdmin();
        allow update: if (
          resource != null
          && validPredictionWrite(entryUid, fixtureId)
          && !maintenanceOn()
          && resource.data.get('awarded', false) != true
        ) || isAdmin();
        allow delete: if false;
      }
    }

    function cacheProvesNewEntry(cache) {
      let fixtureId = getAfter(cache).data.joinedFixtureId;
      return fixtureId is string
        && fixtureId.matches('^[0-9]+$')
        && !exists(/databases/$(database)/documents/predictions/$(fixtureId)/entries/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/predictions/$(fixtureId)/entries/$(request.auth.uid));
    }

    function gameweekPlayerCountBefore() {
      return resource.data.keys().hasAny(['playerCount']) && resource.data.playerCount is int
        ? resource.data.playerCount
        : 0;
    }

    // +1 only when this batch creates the user's first entry, proved by
    // joinedFixtureId on the new gameweek cache. A cache write alone cannot
    // increment the count.
    function isPredictorJoin(gameweekId) {
      let cache = /databases/$(database)/documents/users/$(request.auth.uid)/gameweek_predictions/$(gameweekId);
      let afterCount = getAfter(gameweekPath(gameweekId)).data.get('playerCount', 0);
      return isSignedIn()
        && !maintenanceOn()
        && resource != null
        && changedKeys().hasOnly(['playerCount'])
        && afterCount == gameweekPlayerCountBefore() + 1
        && afterCount is int
        && !exists(cache)
        && existsAfter(cache)
        && cacheProvesNewEntry(cache);
    }

    match /gameweeks/{gameweekId} {
      // Drafts are admin-only. Public list queries must constrain status to
      // active, completed, or archived (rules are not filters).
      // playerCount is the public unique-predictor total for the signed-out dashboard.
      allow read: if isAdmin() || isPublicGameweekStatus(resource.data.status);
      allow create: if isAdmin();
      allow update: if isPredictorJoin(gameweekId) || isAdmin();
      allow delete: if isAdmin();

      match /fixtures/{fixtureId} {
        allow read: if gameweekReadable(gameweekId);
        allow create, update, delete: if isAdmin();
      }
    }

    match /shopItems/{itemId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isStockDecrement(itemId);
    }

    match /settings/{docId} {
      // adminUids lives here. Only admins can read it; useIsAdmin treats a
      // permission-denied settings read as "not an admin".
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /redemptions/{redemptionId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin() || validRedemptionCreate(redemptionId);
      allow update: if isAdmin() || ownerFulfillsRedemption();
      allow delete: if isAdmin();
    }

    match /referrals/{referralId} {
      allow read: if isSignedIn()
        && (resource.data.referrerUid == request.auth.uid
          || resource.data.referredUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /fixture_searches/{cacheKey} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
